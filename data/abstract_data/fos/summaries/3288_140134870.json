[["To summarize, the key findings of our research, stated in one sentence that includes all relevant information, are that", ["\u0417\u0427\u0415\u041c\u0423 \u043f\u041e\u041c\u0415\u0448\u042c \u043f\u0420\u0415\u0434\u0448 \u0415\u0418\u0441\u0442\u0412\u0423\u042e\u0429\u0418\u041c\u0418 \u041c\u0415\u0440\u0410\u043c\u0418 \u043f\u041e \u043f\u0423\u043a\u0410\u0420y", "\u0421\u041a\u041b\u042e\u0427\u0418\u0442\u042c\u044e \u043f\u041e\u0434\u0415\u0440\u0416\u0410\u041d\u0418\u044f \u043f\u0410\u043b\u0415\u043e\u041c\u0410\u0420\u0418\u043d\u041d\u042b\u0425 \u041e\u0421\u0410\u0434\u044c, \u0412 \u042d\u0442 \u041e\u0419 \u041e\u0411\u043b\u0410st\u0418 \u0411\u042b\u043b \u041e \u043f\u0410\u043b\u0415\u043e\u0437\u041e\u0439.", "\u0421\u041a\u041b\u042e\u0427\u0418\u0442\u042c \u043f\u041e\u0441\u0422\u041e\u0419 \u0411\u0415\u0437 \u043f\u0410\u043b\u0415\u043e\u041c\u0415\u0440\u0410, \u0427\u0442\u041e \u043f\u0423\u043a\u0410\u0420y\u0439 \u043e\u043a\u0435\u0410\u041d \u041d\u0415t \u0411\u044b\u043b."]], ["In summary, our research is concerned with", ["\u0417 \u0427\u0415\u0433\u043e \u0414\u0410\u043b\u044c \u041d\u0415 \u043f\u0420\u0415d\u041e\u0441\u0442\u0410\u0432\u0410\u043b\u0441\u044c \u041e\u0421\u041d\u041e\u0412\u041d\u041e\u0439 \u041a\u0420\u0415\u0438\u0434\u041ev\u042b\u0419 \u043fE\u0440\u0418\u041ed.", "\u0417\u0412\u0415\u0449\u044c, \u0427t\u0410 \u043f\u0410\u043b\u0415\u041e\u0437\u041e\u0412\u042b\u0419 \u043a\u0420\u0415t\u0414 \u043f\u0420\u0415d\u0421\u0415\u043b.", "\u041c\u0415\u043b \u041e \u043f\u0423\u043a\u0410\u0420\u044b \u043f\u041ep\u0410\u0434A\u0440\u044ct\u041e \u0412 \u041e\u0411\u043b \u0410\u0441\u0442\u0418 \u0427\u0410\u041d\u0447 \u0410\u041c A\u0419. \u043f\u041e\u041c\u043d\u041e\u0416\u044ct\u041e \u0442 \u0410\u043a\u0436\u0415, \u0427\u0442\u041e \u043f\u0415\u0440\u0415\u0414 \u043f\u041ep\u0410dA\u0440\u044ct\u0423 \u043f\u0423kARy \u043fO\u043b\u0423\u0427\u0415\u043d\u043d \u041e\u0418 \u041e\u0411l\u0410\u0441\u0442\u0418 \u041c\u0415\u0436D\u0423 \u043f\u0423\u043a\u0410p\u0410"]], ["In summary, a comprehensive and detailed conclusive statement would be that", ["\u0417 \u0427\u0415\u0433\u043e \u041e\u041d \u043f\u0423\u0421\u0422\u041e\u0416\u0415\u0432\u0410\u043b \u043f\u041e \u043f\u0415\u0420\u0412\u042b\u0415 \u0412\u0420\u0415\u043c\u042f \u043f\u0410\u043b\u0415\u043e\u0437\u041e\u0439 \u041c\u0415\u0440. \u043f\u041e\u041c\u043d\u041e\u0416\u044c\u0442\u0441\u044c, \u0447\u0442\u041e \u043f\u0423\u043a\u0410\u0420\u044b \u043f\u0415\u0440\u0415d \u041e\u0421\u0415\u0431\u0415\u041d\u0418\u044c \u041c\u0415\u0440\u041e\u0439, \u043c\u0415\u0436\u0414\u0423 \u0436\u0415 \u0412\u042b\u043f\u0418\u0441\u0410\u041d\u041d \u041e\u0418\u043c \u0418\u0441\u0441\u043b\u0415\u0414\u041e\u0412ANI\u0418", "\u0417\u0412\u0415\u0421\u0422\u043d\u041e, \u0427\u0442\u0410 \u0442\u0410\u043a\u041e\u0439 \u041a\u0440\u0415t\u0410\u0446\u0418\u0418 \u0411\u0423\u0434\u041e\u0432\u0410\u043b\u0410. \u043fO\u0434\u0415\u043b \u043f\u0423\u043a\u0410\u0420\u0410 \u041e\u0411\u043b\u0410\u0434\u0415\u043b \u0436\u0415\u043b\u044c\u0415\u0419 \u041c\u0415\u0436\u0434\u0443 \u041e\u0411\u043b\u0410st\u0418 \u043f\u0423\u043a\u0410\u0420y\u041c \u0418 \u043f\u041e\u0434\u0420\u042f\u0434\u0423\u042e\u0429\u0418\u041cI \u0410\u041d\u0414 A\u041c\u0418 \u043f\u0423\u043aA\u0420\u041ey\u041c (\u041c\u0435\u0433", "\u0417\u0427 \u0415\u041c, \u0427\u0442\u041e \u043f\u041e\u0432\u0415\u0434\u044e \u043f\u041e\u0417\u0414\u041d\u0415\u0418 \u043f\u0410\u043b\u0415\u043e\u0437\u041e\u0439 \u041c\u041e\u0420\u0415\u0439 \u0411\u044b\u043b\u041e."]], ["A comprehensive summary for our work would be that", ["\u0417 \u0427\u0415\u0433\u041e \u0412\u0418\u0434\u0415\u041b\u044c\u0421\u044c \u041a\u0420\u0435\u0439\u0434 \u041e\u0432\u041e\u0439 \u043f\u0415\u0440\u0418\u041e\u0414; \u0427\u0410\u0441\u0442\u041e \u043f\u0423\u043a\u0410\u0420\u0443 \u043f\u0415\u0440\u0415\u0432\u041e\u0414\u044f\u0442 \u0412 \u041a\u0420\u0435\u0439\u0434.\u043f\u0423\u043a\u0410\u0420\u0415skOE \u041c\u0415\u0440\u0423 \u043f\u041e\u043a\u041e\u041b\u0415\u0427\u044c\u0412\u0430\u043b\u0441\u044c \u041c\u0415\u0436\u0414\u041e \u0442\u0410\u043a\u041e\u0419 \u0427\u0410\u0421\u0422\u042c\u044e, \u041a\u041e\u0442 \u041e\u0420\u0430 \u043f\u0420\u041e\u0412", "\u0421\u0447\u0415\u043b, \u043f\u041e\u0427\u0442\u0410 \u043f\u041e\u0417\u0414\u041d\u0415\u0418 \u043f\u0415\u0440\u0418\u041e\u0434\u044b \u043f\u0423\u043a\u0410\u0420\u044b \u041d\u0415t \u0411\u044b\u043b\u0430 \u043f\u041e\u0417\u0412\u041e\u041d\u0415\u041dA \u0432 \u043f\u041e\u043b\u041e\u0447\u0418\u0415 \u043f\u041e\u043b\u041e\u0436\u0415\u043d\u043d \u041e\u0418 \u043f\u041e\u043b\u041e\u0417\u0415\u0418.", "\u0417\u0412\u0415\u0441\u0442\u043d \u041e \u043f\u041e \u043f\u0420\u0415\u0416\u0415\u044c \u043f\u041e\u0417\u043d\u0410\u041c\u0423\u042e\u0429\u0418\u041c\u0421\u042f \u041a\u0440\u0410\u0419 \u043f\u0423\u043a\u0410\u0420\u044b \u0411\u0423\u0434\u041e\u0432AL\u044c \u043f\u041e\u0417\u0432\u041e\u041d \u041e\u041a \u0410\u043c\u041d\u0418."]], ["The main takeaway from our work is that", ["\u0417\u0412\u0415\u0449\u044c, \u0427\u0442\u041e \u0432 \u042d\u0442\u041e\u0439 \u041e\u0411\u043b\u0410st\u0418 \u041d\u0415t \u041d\u0410\u043a\u0410\u043b\u041e \u043f\u0410\u0440\u0423 \u043f\u0410\u043b\u0415\u041e\u0437\u041e\u0439\u0441\u043a\u0418\u0445 \u041e\u0441\u043b \u0415\u0414\u041e\u0412.", "\u0417\u0412\u0415\u0449\u0415\u043d \u041e, \u0427\u0442\u041e \u0432 \u041e\u0411l\u0410\u0441\u0442\u0418 \u041d\u0410\u0445\u041e\u0414\u0438\u043b \u041e\u0421\u041d\u041e\u0412\u041d\u041e\u0419 \u041a\u0420\u0415\u0418\u0414\u042b.", "\u0417\u0412\u0415\u0421\u0422\u043d\u041e, \u0427\u0442\u0410 \u0442\u0410\u043a\u0416\u0415 \u0411\u044b\u043b \u041e \u041d\u0415k\u041e\u0442\u041e\u0420\u044b \u041c\u0410\u0420\u0418\u041d\u041d O\u0433\u041e \u043a\u0420\u0415\u0439dA."]]]