[["To summarize, the key findings of our research, stated in one sentence that includes all relevant information, are that", ["\u043c, \u043a\u043e\u0442\u043e\u0440\u044b\u0435, \u043a\u0430\u043a \u0441\u043b\u0435\u0434\u043e\u0432\u0430\u0442\u0435\u043b\u044c\u043d\u043e, \u0431\u044b\u043b\u0438 \u0432\u0441\u0442\u0440\u043e\u0435\u043d\u044b \u0432 \u043e\u0447\u0435\u043d\u044c \u043f\u043b\u043e\u0441\u043a\u043e \u043a\u0440\u043e\u043c\u043a\u0438 \u043f\u043b\u0443\u0442\u043e\u043d\u043e\u0432 \u0438\u043b\u0438, \u043f\u043e\u0434\u043e\u0431\u043d\u043e \u0440\u0438\u043e\u043b\u0438\u0442\u043e\u0432\u044b\u043c Challis, \u0438\u0437\u0432\u0435\u0440\u0433\u043d\u0443\u0442\u044b \u043f\u0440\u0438\u043c\u0435\u0440\u043d\u043e \u0432 52 \u0438\u043b\u0438 53 \u043c\u0438\u043b\u043b\u0438\u043e\u043d\u0430\u0445 \u043b\u0435 \u0442 \u0442\u043e\u043c\u0443 \u0432\u043f\u0435\u0440\u0435\u0434.", "\u043c, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0431\u044b\u043b\u0438 \u0432\u043d\u0435\u0434\u0440\u0435\u043d\u044b \u0432 \u0432\u0438\u0434\u0435 \u043e\u0447\u0435\u043d\u044c \u043f\u043b\u043e\u0441\u043a\u043e \u043d\u044f\u044e\u0449\u0438\u0445 plutonov \u0438\u043b\u0438, \u043a\u0430\u043a Challis rhyolithic volcanics, \u0438\u0437\u0432\u0435\u0440\u0433\u043d\u0443\u0442\u044b \u043f\u0440\u0438\u043c\u0435\u0440\u043d\u043e 52 \u0438\u043b\u0438 53 \u043c\u0438\u043b\u043b\u0438\u043e\u043d\u043e\u0432 \u043b\u0435\u0442 \u0442\u043e\u043c\u0443 \u043d\u0430\u0437\u0430\u0434.\u041c\u0435\u043b\u043e\u043d\u0438\u0442 \u0437\u0435\u043b\u0451\u043d\u043e\u0441\u043b\u0430\u043d\u0446\u0435\u0432\u043e\u0439 \u0444\u0430\u0446\u0438\u0438 \u0438 \u0445\u043b\u043e\u0440\u0438\u0442\u043e\u0432\u0430\u044f \u0431\u0440\u0435\u043a\u0447\u0430 \u0441\u0444\u043e\u0440\u043c\u0438\u0440\u043e\u0432\u0430\u043b \u0438\u0441\u044c\u0441\u044f \u0432\u043e \u0432\u0440\u0435\u043c\u044f \u0434\u0430\u043b\u044c\u043d\u0435\u0439\u0448\u0435\u0433\u043e \u043e\u0445\u043b\u0430\u0436\u0434\u0435\u043d\u0438\u044f \u0434\u043e \u043f\u0440\u0438\u043c\u0435\u0440\u043d\u043e 100 \u00b0\u0421, \u043f\u0440\u0438 \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u0438 \u0432 \u0440\u0430\u0439\u043e\u043d\u0435 \u0412\u043e\u0441\u0442\u043e\u0447\u043d\u043e\u0433\u043e \u0441\u043a", "\u043c, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0431\u044b\u043b\u0438 \u0432\u043f\u043e\u0441\u043b\u0435 \u0434\u0435\u043d\u044b \u0432 \u043a\u0430\u0447\u0435\u0441\u0442\u0432\u0435 \u043e\u0447\u0435\u043d\u044c \u043f\u043b\u043e\u0441\u043a\u0438\u0445 \u043f\u043b\u0443\u0442\u043e\u043d\u043e\u0432 \u0438\u043b\u0438, \u043f\u043e \u0432\u0441\u0435\u0439 \u0432\u0435 \u0440\u043e\u044f\u0442\u043d\u043e\u0441\u0442\u0438, \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043b\u0438\u0441\u044c \u0432 \u0432\u0438\u0434\u0435 Challis \u0440\u0438\u043e-\u043b\u0438\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u0432\u0443\u043b\u043a\u0430\u043d\u0438\u0442\u043e\u0432 52 \u0438\u043b\u0438 53 \u043c\u0438\u043b\u043b\u0438\u043e\u043d \u043d\u044b \u043b\u0435\u0442\u0430 \u0442\u043e\u043c\u0443 \u043d\u0430\u0437\u0430\u0434."]], ["In summary, our research is concerned with", ["\u043c, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0437\u0430\u0442\u0435\u043c \u0432\u043d\u0435\u0434\u0440\u0438 \u043b\u0438\u0441\u044c \u0432 \u043a\u0430\u0447\u0435\u0441\u0442\u0432\u0435 \u043e\u0447\u0435\u043d\u044c \u043f\u043b\u043e\u0441\u043a\u043e \u043d\u044b\u0445 \u043f\u043b\u0443\u0442\u043e\u043d\u043e\u0432 \u0438\u043b\u0438 \u0436\u0435 \u0432\u044b\u0442\u0435 \u043a\u043b\u0438 \u0432 Challis-ryolitic volcanics, \u0438\u043c\u0435\u044e\u0449\u0438\u0445 52 \u0438\u043b\u0438 53 \u043c\u0438\u043b\u043b\u0438\u043e\u043d\u0430 \u043b\u0435\u0442.", "\u043c, \u043a\u043e\u0442\u043e\u0440\u044b\u0435, \u0432 \u0441\u0432\u043e\u044e \u043e\u0447\u0435\u0440\u0435\u0434\u044c, \u0431\u044b\u043b\u0438 \u0432\u043b\u043e\u0436\u0435 \u043d\u044b \u0432 \u043e\u0447\u0435\u043d\u044c \u043f\u043b\u043e\u0441\u043a\u0438\u0435 \u043f\u043b\u0443\u0442\u043e \u043d\u044b \u0438\u043b\u0438 \u0438\u0437\u0432\u0435\u0440\u0433\u043b\u0438\u0441\u044c \u0432 \u0432\u0438\u0434\u0435 Challis \u0440\u0438\u043e\u043b\u0438\u0442\u043e\u0432\u044b\u0445 \u0432\u0443\u043b\u043a\u0430\u043d\u0438\u0442\u043e\u0432 \u043f\u0440\u0438\u043c\u0435\u0440\u043d\u043e 52 \u0438\u043b\u0438 53 \u043c\u0438\u043b\u043b\u0438\u043e\u043d\u043e\u0432 \u043b \u0435\u0442 \u0442\u043e\u043c\u0443 \u043d\u0430\u0437\u0430\u0434.", "\u043c, \u0432\u043f\u043e\u0441\u043b\u0435\u0434\u0441\u0442\u0432\u0438\u0438 \u0432\u043a\u043b\u0438 \u043d\u0443\u0432\u0448\u0438\u0445\u0441\u044f \u0432 \u0432\u0438\u0434\u0435 \u043e\u0447\u0435\u043d\u044c \u043c\u0435\u043b\u043a\u043e \u0437\u0430\u043b\u0435\u0433\u0430\u044e\u0449\u0438\u0445 \u043f\u043b\u0443\u0442\u043e\u043d\u043e\u0432, \u043b\u0438\u0431\u043e \u0432\u044b\u0440\u044b\u0432\u0430 \u044e\u0449\u0438\u0445\u0441\u044f \u0432 \u0432\u0438\u0434\u0435 \u0432\u0443\u043b\u043a\u0430\u043d\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u0440\u0438\u043e\u043b\u0438\u0442\u043e\u0432 Challis \u043e\u043a\u043e\u043b\u043e 52 \u0438\u043b\u0438 53 \u043c\u0438\u043b\u043b\u0438\u043e\u043d\u043e\u0432 \u043b \u0435\u0442 \u043d\u0430\u0437\u0430\u0434."]], ["In summary, a comprehensive and detailed conclusive statement would be that", ["\u043c, \u043a\u043e\u0442\u043e\u0440\u044b\u0435, \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e, \u0432 \u0432\u0438\u0434\u0435 \u043e\u0447\u0435\u043d\u044c \u043f\u043b\u043e\u0441\u043a\u0438\u0445 \u043f\u043b\u0443\u0442\u043e\u043d \u043e\u0432 \u0431\u044b\u043b\u0438 \u0432\u0432\u0435\u0434\u0435\u043d\u044b \u0432 \u043f\u043e\u0440\u043e\u0434\u044b \u0438\u043b\u0438 \u0436\u0435, \u043a\u0430\u043a Challis \u0440\u0438\u043e\u043b\u0438\u0442, \u0432\u044b\u0434\u0435\u043b\u0438\u043b\u0438\u0441\u044c \u0432 \u0432\u0438\u0434\u0435 \u0432\u0443\u043b\u043a\u0430\u043d\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u043f\u043e\u0442\u043e\u043a\u043e\u0432 \u043e\u043a\u043e\u043b\u043e 52 \u0438\u043b\u0438 53 \u043c\u0438\u043b\u043b\u0438\u043e\u043d\u043e\u0432 \u043b\u0435\u0442 \u0442\u043e\u043c\u0443 \u043d\u0430\u0437\u0430\u0434.\u041c\u0435\u043b\u043e\u043d\u0438\u0442 \u0444\u0430\u0446\u0438\u0438 \u0437\u0435\u043b\u0435\u043d\u043e \u0441\u043b\u0430\u043d\u0446\u0435\u0432\u043e\u0439 \u0438 \u0445\u043b\u043e\u0440\u0438\u0442\u043e\u0432\u0430\u044f \u0431\u0440\u0435\u043a\u0447\u0438\u044f \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043b\u0438\u0441\u044c \u0432 \u043f\u0440\u043e\u0446\u0435\u0441\u0441\u0435 \u0434\u0430\u043b\u044c\u043d\u0435\u0439\u0448\u0435\u0433\u043e \u043e\u0445\u043b\u0430\u0436\u0434\u0435\u043d\u0438\u044f \u0434\u043e \u043f\u0440\u0438\u043c\u0435\u0440\u043d\u043e 100 \u00b0\u0421, \u0432 \u043f\u0435\u0440\u0438\u043e\u0434 \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430", "\u043c, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0437\u0430\u0442\u0435\u043c \u0431\u044b\u043b\u0438 \u0432\u0432\u0435\u0434\u0435 \u043d\u044b \u0432 \u0432\u0438\u0434\u0435 \u043e\u0447\u0435\u043d\u044c \u0431\u043b\u0438\u0437\u043a\u043e \u043a \u043f\u043e\u0432\u0435\u0440\u0445\u043d\u043e\u0441\u0442\u0438 \u043f\u043b\u0443\u0442\u043e\u043d\u043e\u0432 \u0438\u043b\u0438 \u0436\u0435 \u0432\u044b\u0440 \u0443\u043b\u0438\u0441\u044c \u0432 \u0432\u0438\u0434\u0435 \u0440\u0438\u043e\u043b\u0438\u0442\u043e\u0432\u044b\u0445 \u0432\u0443\u043b\u043a\u0430\u043d\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u043f\u043e\u0440\u043e\u0434 Challis \u043f\u0440\u0438\u043c\u0435\u0440\u043d\u043e 52 \u0438\u043b\u0438 53 \u043c\u0438\u043b\u043b\u0438\u043e \u043d\u043d\u044b\u0445 \u043b\u0435\u0442 \u0442\u043e\u043c\u0443 \u043d\u0430\u0437\u0430\u0434.", "\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u043f\u043e\u0442\u043e\u043a\u043e\u0432, \u043a\u043e\u0442\u043e\u0440\u044b\u0435, \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e, \u0432 52 \u0438\u043b\u0438 53 \u043c\u0438\u043b\u043b\u0438\u043e\u043d \u043d\u044b\u0445 \u043b\u0435\u0442 \u0442\u043e\u043c\u0443 \u043d\u0430\u0437\u0430\u0434 \u0431\u044b\u043b\u0438 \u0438\u043d \u0442\u0440\u0443\u0437\u0438\u0432\u043d\u044b\u043c\u0438, \u0438\u043b\u0438 \u0436\u0435 \u0432\u044b\u0440 \u044f\u043b\u0438\u0441\u044c \u0432 \u0432\u0438\u0434\u0435 \u0440\u0438\u043e\u043b\u0438\u0442\u043e\u0432 \u0438\u0437 \u043f \u043b\u0430\u0432\u044b Challis."]], ["A comprehensive summary for our work would be that", ["\u043c, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0437\u0430\u0442\u0435\u043c \u0431\u044b\u043b\u0438 \u0432\u0432\u0435\u0434\u0435\u043d\u044b \u0432 \u043f\u043b\u0430 \u0441\u0442\u0438\u0447\u0435\u0441\u043a\u0443\u044e \u0437\u043e\u043d\u0443 \u0432 \u0432\u0438\u0434\u0435 \u043e\u0447\u0435\u043d\u044c \u043c\u0430\u043b\u043e \u0433\u043b\u0443\u0431\u043e\u043a\u0438\u0445 \u043f\u043b\u0443\u0442\u043e\u043d\u043e\u0432 \u0438\u043b\u0438 \u0438\u0437\u0432\u0435\u0440\u0433\u043b\u0438\u0441\u044c \u0432 \u0432\u0438\u0434\u0435 \u0440\u0438\u043e\u043b\u0438\u0442\u043e\u0432 Challis \u043e\u043a\u043e\u043b\u043e 52 \u0438\u043b\u0438 53 \u043c\u0438\u043b\u043b\u0438\u043e\u043d\u043e\u0432 \u043b\u0435 \u0442\u043e\u043c \u043d\u0430\u0437\u0430\u0434.", "\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u043c\u0430\u0441\u0441, \u043a\u043e\u0442\u043e\u0440\u044b\u0435, \u0432 \u0441\u0432\u043e\u044e \u043e\u0447\u0435\u0440\u0435\u0434\u044c, \u0431\u044b\u043b\u0438 \u0432\u043b\u043e\u0436\u0435\u043d\u044b \u0432 \u043f\u043b\u0443\u0442\u043e\u043d\u044b, \u043b\u0435\u0436\u0430\u0432\u0448\u0438\u0435 \u043d\u0430 \u043f\u043e\u0432\u0435\u0440\u0445\u043d\u043e\u0441\u0442\u0438, \u0438\u043b\u0438 \u0436\u0435 \u0438\u0437\u0432\u0435\u0440\u0433\u043d\u0443\u0442\u044b \u0432 \u0432\u0438\u0434\u0435 \u0440\u0438\u043e\u043b\u0438\u0442\u043e\u0432\u044b\u0445 \u0432\u0443\u043b\u043a\u0430\u043d\u0438\u0442\u043e\u0432 Challis \u0432 52 \u0438\u043b\u0438 53 \u043c\u0438\u043b\u043b\u0438\u043e \u043d\u043d\u044b \u043b\u0435 \u0442 \u0442\u043e\u043c\u0443 \u043da\u0437\u0430\u0434.", "\u043c, \u043a\u043e\u0442\u043e\u0440\u044b\u0435, \u0432 \u0441\u0432\u043e\u044e \u043e\u0447\u0435\u0440\u0435\u0434\u044c, \u0431\u044b\u043b\u0438 \u0432\u0441\u0442\u0440\u043e\u0435\u043d\u044b \u0432 \u043e\u0447\u0435\u043d\u044c \u043f\u043b\u043e\u0441\u043a\u0438\u0435 \u043f\u043b\u0443\u0442\u043e\u043d\u044b \u0438\u043b\u0438 \u0438\u0437\u0432\u0435\u0440\u0433\u043d\u0443 \u0442\u0441\u044f \u0432 \u0432\u0438\u0434\u0435 \u0440\u0438\u043e\u043b\u0438\u0442\u043e\u0432 Challis \u0432 \u043f\u0435\u0440\u0438\u043e\u0434 52 \u0438\u043b\u0438 53 \u043c\u0438\u043b\u043b\u0438\u043e \u043d\u0430 \u043b\u0435\u0442 \u0442\u043e\u043c\u0443 \u043d\u0430\u0437\u0430\u0434."]], ["The main takeaway from our work is that", ["\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u043c\u0430\u0441\u0441, \u0432\u0440\u0435\u0437\u0430 \u0432\u0448\u0438 \u0435\u0441\u044f \u0432 \u043f\u043b\u0443\u0442\u043e\u043d\u0435 \u0438\u043b\u0438 \u0438\u0437\u0432\u0435\u0440\u0433\u0430\u044e \u0449\u0438\u0435\u0441\u044f \u0432 \u0432\u0438\u0434\u0435 \u0440\u0438\u043e\u043b\u0438\u0442\u043e\u0432\u044b\u0445 \u0432\u0443\u043b\u043a \u0430\u043d\u0438\u0442\u043e\u0432 Challis, 52 \u0438\u043b\u0438 53 \u043c\u0438\u043b\u043b\u0438\u043e\u043d \u0430 \u043b\u0435\u0442 \u0442\u043e\u043c\u0443 \u043d\u0430\u0437\u0430\u0434.", "\u043c, \u0432\u0441\u0442\u0440\u043e\u0435\u043d\u043d\u044b\u0445 \u0432 \u043a\u0430\u0447\u0435\u0441\u0442\u0432\u0435 \u043e\u0447\u0435\u043d\u044c \u043f\u043b\u043e\u0441\u043a\u0438\u0445 \u043f\u043b\u0443\u0442\u043e\u043d\u043e\u0432 \u0438\u043b\u0438, \u043a\u0430\u043a \u0432 \u0441\u043b\u0443\u0447\u0430\u0435 \u0441 \u0440\u0438\u043e\u043b\u0438\u0442\u0430\u043c\u0438 Challis, \u0438\u0437\u0432\u0435\u0440\u0433\u0448\u0438\u0445\u0441\u044f 52 \u0438\u043b\u0438 53 \u043c\u0438\u043b\u043b\u0438\u043e \u043d\u043d\u044b\u0445 \u043b\u0435\u0442 \u0442\u043e\u043c\u0443 \u043d\u0430\u0437\u0430\u0434.", "\u043c, \u043a\u043e\u0442\u043e\u0440\u044b\u0435, \u0432 \u0441\u0432\u043e\u044e \u043e\u0447\u0435\u0440\u0435\u0434\u044c, \u0431\u044b\u043b\u0438 \u0432\u0432\u0435\u0434\u0435\u043d\u044b \u0432 \u043f\u043b\u0443\u0442\u043e\u043d\u044b, \u0440\u0430\u0441\u043f\u043e\u043b\u043e\u0436\u0435\u043d\u043d\u044b\u0435 \u043d\u0430 \u0433\u043b\u0443\u0431\u0438\u043d\u0435 \u0438, \u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e, \u0438\u0437\u0432\u0435\u0440\u0433\u043d\u0443 \u0442\u044b Challis rhyolith, \u043f\u0440\u0438\u043c\u0435\u0440\u043d\u043e 52 \u0438\u043b\u0438 53 \u043c\u0438\u043b\u043b\u0438\u043e\u043d\u043e\u0432 \u043b\u0435\u0442 \u0442\u043e\u043c\u0443 \u043d\u0430\u0437\u0430\u0434.\u041c\u0438\u043b\u043e\u043d\u0438\u0442 \u0437\u0435\u043b \u0435\u043d\u043e\u0433\u043e \u0441\u043b\u0430\u043d\u043a\u0430 \u0438 \u0445\u043b\u043e\u0440\u0438 \u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u0440\u0430\u0437\u043b\u043e\u043c\u044b \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043b\u0438\u0441\u044c \u0432\u043e \u0432\u0440\u0435\u043c\u044f \u0434\u0430\u043b\u044c\u043d\u0435\u0439\u0448\u0435\u0439 \u043e\u0445\u043b\u0430\u0436\u0434\u0435\u043d \u043d\u043e\u0441\u0442\u0438 \u0434\u043e \u043f\u0440\u0438\u043c\u0435\u0440\u043d\u043e 100 \u00b0\u0421, \u0432 \u0445\u043e\u0434\u0435 \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430 \u043d\u0438\u044f \u043b\u0438\u0441\u0442\u0440\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u0440\u0430\u0437\u043b\u043e\u043c"]]]