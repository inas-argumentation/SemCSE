[["To summarize, the key findings of our research, stated in one sentence that includes all relevant information, are that", ["\u043e\u0431\u043c\u0435\u043d \u0430 \u043c\u0430\u0441\u0441\u043e\u0439 \u043c\u0435\u0436\u0434\u0443 \u043a\u043e\u0440\u043e\u0439 \u0438 \u043c\u0430\u043d\u0442\u0438 \u0435\u0439.", "\u043e\u0431\u043c\u0435\u043d\u0430 \u043c\u0430\u0441\u0441\u043e\u0439 \u043c\u0435\u0436\u0434\u0443 \u043a\u043e\u0440\u043e\u0439 \u0438 \u043c\u0430\u043d\u0442\u0438 \u0435\u0439.", "\u043e\u0431\u043c\u0435\u043d\u043e\u0432 \u043c\u0430\u0441\u0441\u044b \u043c\u0435\u0436\u0434\u0443 \u043a\u043e\u0440\u043e\u0439 \u0438 \u043c\u0430\u043d\u0442\u0435\u043b\u044c\u044e."]], ["In summary, our research is concerned with", ["\u043c\u0430\u0441\u0441\u043e\u0432\u043e\u0433\u043e \u043e\u0431\u043c\u0435\u043d\u0430 \u043c\u0435\u0436\u0434\u0443 \u043a\u043e\u0440\u043e\u0439 \u0438 \u043c\u0430\u043d\u0442\u0438 \u0435\u0439.", "\u043c\u0430\u0441\u0441\u043e\u0432\u043e\u0433\u043e \u043e\u0431\u043c\u0435\u043d\u0430 \u043a\u043e\u0440\u043e\u0439 \u0438 \u043c\u0430\u043d\u0442\u0435\u0439\u0435\u043c.", "\u043c\u0430\u0441\u0441\u043e\u0432\u043e\u0433\u043e \u043e\u0431\u043c\u0435\u043d \u0430 \u043c\u0435\u0436\u0434\u0443 \u043a\u043e\u0440\u043e\u0439 \u0438 \u043c\u0430\u043d\u0442\u0438 \u0435\u0439."]], ["In summary, a comprehensive and detailed conclusive statement would be that", ["\u0432\u0437\u0430\u0438\u043c\u043e\u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0439 \u043c\u0435\u0436\u0434\u0443 \u043a\u043e\u0440\u043e\u0439 \u0438 \u043c\u0430\u043d\u0442\u0438 \u0435\u0439, \u043f\u0440\u0438 \u043a\u043e\u0442\u043e\u0440\u044b\u0445 \u043f\u0440\u043e\u0438\u0441\u0445\u043e\u0434\u0438\u0442 \u043e\u0431\u043c\u0435\u043d \u0432\u0435\u0449\u0435\u0441\u0442\u0432\u043e\u043c.", "\u043c\u0430\u0441\u0441\u043e\u0432\u044b\u0445 \u043e\u0431\u043c\u0435\u043d\u043e\u0432 \u043c\u0435\u0436\u0434\u0443 \u043a\u043e\u0440\u043e\u0439 \u0438 \u043c\u0430\u043d\u0442\u0438\u0435\u0439.", "\u043e\u0431\u043c\u0435\u043d\u0430 \u043c\u0430\u0441\u0441\u043e\u0439 \u043c\u0435\u0436\u0434\u0443 \u043a\u043e\u0440\u043e\u0439 \u0438 \u043c\u0430\u043d\u0442\u0438\u0435\u0439."]], ["A comprehensive summary for our work would be that", ["\u043c\u0430\u0441\u0441\u043e\u043e\u0431\u043c\u0435\u043d\u0430 \u043c\u0435\u0436\u0434\u0443 \u043a\u043e\u0440\u043e\u0439 \u0438 \u043c\u0430\u043d\u0442\u0438\u0435\u0439.", "\u043c\u0430\u0441\u0441\u043e\u0432\u044b\u0445 \u043e\u0431\u043c\u0435\u043d\u043e\u0432 \u043c\u0435\u0436\u0434\u0443 \u043a\u043e\u0440\u043e\u0439 \u0438 \u043c\u0430\u043d\u0442\u0438 \u0435\u0439.", "\u0432\u0437\u0430\u0438\u043c\u043e\u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044f \u043c\u0435\u0436\u0434\u0443 \u043a\u043e\u0440\u043e\u0439 \u0438 \u043c\u0430\u043d\u0442\u0438\u0435\u0439."]], ["The main takeaway from our work is that", ["\u043c\u0430\u0441\u0441\u043e\u0432\u043e\u0433\u043e \u043e\u0431\u043c\u0435\u043d\u0430 \u043c\u0435\u0436\u0434\u0443 \u043a\u043e\u0440\u043e\u0439 \u0438 \u043c\u0430\u043d\u0442\u0435\u0439\u0435\u043c.", "\u043c\u0430\u0441\u0441\u043e\u0432\u043e\u0433\u043e \u043e\u0431\u043c\u0435\u043d\u0430 \u043c\u0435\u0436\u0434\u0443 \u043a\u043e\u0440\u043e\u0439 \u0438 \u043c\u0430\u043d\u0442\u0438\u0435\u0439.", "\u043c\u0430\u0441\u0441\u043e\u0432\u044b\u0445 \u043e\u0431\u043c\u0435\u043d\u043e\u0432 \u043c\u0435\u0436\u0434\u0443 \u043a\u043e\u0440\u043e\u0439 \u0438 \u043c\u0430\u043d\u0442\u0438\u0435\u0439."]]]