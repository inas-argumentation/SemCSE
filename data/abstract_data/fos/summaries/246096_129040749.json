[["To summarize, the key findings of our research, stated in one sentence that includes all relevant information, are that", ["\u0428\u0442\u0438\u0440\u0438\u0439\u0441\u043a\u0438\u0445 \u0433 \u0440\u0430\u0443\u0432\u0430\u043a\u043a\u043e\u0432; \u0441\u0435\u0440\u0438\u044f \u041d\u043e\u043a \u0432 \u0433\u0443\u0440\u043a\u0442\u0430\u043b\u044c\u043d\u044b\u0445 \u0410\u043b\u044c\u043f\u0430 \u0445.", "\u0433\u0440\u0430\u0443\u0432\u0430\u043a\u043a\u043e \u0432\u0430 \u0428\u0442\u0438\u0440\u0438\u0438; \u0441\u0435\u0440\u0438\u044f \u041d\u043e \u043a\u043a\u0430 \u0432 \u0433\u0443\u0440\u043a\u0442 \u0430\u043b\u044c\u0441\u043a\u0438\u0445 \u0410\u043b\u044c\u043f\u0430\u0445.", "\u0433\u0440\u0430\u0443\u0432\u0430\u043a\u043a\u043e \u0432\u043e\u0439 \u0428\u0442\u0438\u0440\u0438\u0438; \u0441\u0435\u0440\u0438\u044f \u041d\u043e\u043a \u0432 \u0433\u0443\u0440\u043a\u0442\u0430\u043b\u0441\u043a\u0438\u0445 \u0410\u043b\u044c\u043f\u0430\u0445."]], ["In summary, our research is concerned with", ["\u0433\u0440\u0430\u0443\u0432\u0430\u043a\u043a\u043e \u0432\u043e\u0439 \u0428\u0442\u0438\u0440\u0438\u0438, \u0441\u0435\u0440\u0438\u044f \u041d\u043e\u043a \u0432 \u0433\u0443\u0440\u043a\u0442\u0430\u043b\u044c\u043d\u044b\u0445 \u0410\u043b\u044c\u043f \u0430\u0445.", "\u0428\u0442\u0438\u0440\u0441\u043a\u043e\u0439 \u0433\u0440\u0430\u0443\u0432\u0430\u043a\u043a\u043e \u0432\u043e\u0439; \u0441\u0435\u0440\u0438\u044f \u041d\u043e\u043a \u0432 \u0433\u0443\u0440\u043a\u0442 \u0430\u043b\u044c\u0441\u043a\u0438\u0445 \u0410\u043b\u044c\u043f\u0430\u0445.", "\u0433\u0440\u0430\u0443\u0432\u0430\u043a\u043a\u043e \u0432\u0430 \u0432 \u0428\u0442\u0438\u0440\u0438\u0438; \u0441\u0435\u0440\u0438\u044f \u041d\u043e\u043a \u0432 \u0433\u0443\u0440\u043a\u0442\u0430\u043b\u0441\u043a\u0438\u0445 \u0410 \u043b\u043b\u044f\u0445."]], ["In summary, a comprehensive and detailed conclusive statement would be that", ["\u0433\u0440\u0430\u0443\u0432\u0430\u043a\u043a\u043e \u0432\u043e\u0439 \u0428\u0442\u0438\u0440\u0438\u0438; \u0441\u0435\u0440\u0438\u044f \u041d\u043e\u043a \u0432 \u0433\u0443\u0440\u043a\u0442\u0430\u043b\u0441\u043a\u0438\u0445 \u0410\u043b\u044c\u043f \u0430\u0445.", "\u0433\u0440\u0430\u0443\u0432\u0430\u043a\u043a\u043e \u0432\u0430 \u0428\u0442\u0438\u0440\u0438\u0438; \u0441\u0435\u0440\u0438\u044f \u041d\u043e\u043a \u0432 \u0433\u0443\u0440\u043a\u0442\u0430\u043b\u0441\u043a\u0438\u0445 \u0410 \u043b\u044c\u043f\u0430\u0445.", "\u0433\u0440\u0430\u0443\u0432\u0430\u043a\u043a\u043e \u0432\u0430 \u0428\u0442\u0438\u0440\u0438\u0438, \u0441\u0435\u0440\u0438\u044f \u041d\u043e\u043a\u043a \u0432 \u0433\u0443\u0440\u043a\u0442\u0430\u043b\u044c\u043d\u044b\u0445 \u0410 \u043b\u043f\u0430\u0445."]], ["A comprehensive summary for our work would be that", ["\u0433\u0440\u0430\u0443\u0432\u0430\u043a\u043a\u043e \u0432\u043e\u0439 \u0428\u0442\u0438\u0440\u0438\u0438; \u0441\u0435\u0440\u0438\u044f \u041d\u043e\u043a\u043a\u0430 \u0432 \u0433\u0443\u0440\u043a\u0442\u0430\u043b\u0441\u043a\u0438\u0445 \u0410\u043b\u044c\u043f\u0430 \u0445\u0430\u0445.", "\u0433\u0440\u0430\u0443\u0432\u0430\u043a\u043a\u043e \u0432\u0430 \u0428\u0442\u0438\u0440\u0438\u0438; \u0441\u0435\u0440\u0438\u044f \u041d\u043e\u043a\u043a \u0432 \u0433\u0443\u0440\u043a\u0442\u0430\u043b\u0441\u043a\u0438\u0445 \u0410\u043b\u044c\u043f \u0430\u0445.", "\u0433\u0440\u0430\u0443\u0432\u0430\u043a\u043a\u043e \u0432\u043e\u0439 \u0428\u0442\u0438\u0440\u0438\u0438; \u0441\u0435\u0440\u0438\u044f \u041d\u043e\u043a \u0432 \u0433\u0443\u0440\u043a\u0442\u0430\u043b\u0441\u043a\u0438\u0445 \u0410\u043b\u044c\u043f\u0430 \u0445\u0445."]], ["The main takeaway from our work is that", ["\u0433\u0440\u0430\u0443\u0432\u0430\u043a\u043a\u043e \u0432\u0430 \u0428\u0442\u0438\u0440\u0438\u0438; \u0441\u0435\u0440\u0438\u044f \u041d\u043e\u0446 \u043a \u0432 \u0433\u0443\u0440\u043a\u0442\u0430\u043b\u0441\u043a\u0438\u0445 \u0410\u043b\u044c\u043f\u0430 \u0445\u0430\u0445.", "\u0433\u0440\u0430\u0443\u0432\u0430\u043a\u043a\u043e \u0432\u0430 \u0428\u0442\u0438\u0440\u0438\u0438; \u0441\u0435\u0440\u0438\u044f \u041d\u043e\u043a \u0432 \u0433\u0443\u0440\u043a\u0442\u0430\u043b\u0441\u043a\u0438\u0445 \u0410 \u043b\u044c\u043f\u0430\u0445.", "\u0433\u0440\u0430\u0443\u0432\u0430\u043a\u043a\u043e \u0432\u0430 \u0432 \u0428\u0442\u0438\u0440\u0438\u0438; \u0441\u0435\u0440\u0438\u044f \u041d\u043e\u043a \u0432 \u0433\u0443\u0440\u043a\u0442\u0430\u043b\u0441\u043a\u0438\u0445 \u0410\u043b\u044c\u043f\u0430 \u0445\u0430\u0445."]]]